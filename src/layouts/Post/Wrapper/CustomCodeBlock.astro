---
import WindowCode from '#/components/blocks/WindowCode.svelte';
import { siteConfig } from '#content';
import type { BlogCodeBlockProps } from '#plugins-satteri';

interface Props extends BlogCodeBlockProps {
  lang: string;
}

const { lang, ...restProps } = Astro.props as Props;
const languageOverride = siteConfig.posts.codeBlockLanguageOverride[lang];
---

<figure aria-label="Code Block">
  <WindowCode
    client:visible
    {...restProps}
    attributionAuthor={siteConfig.author}
    attributionSource={Astro.url.toString()}
    language={languageOverride ?? lang}
  >
    <slot />
  </WindowCode>
</figure>
