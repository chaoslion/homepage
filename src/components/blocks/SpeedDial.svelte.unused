<script lang="ts">
  import { onMount } from "svelte";

  import { siteConfig } from "#content";

  interface Props {
    url: URL;
    footerElement: string;
  }

  let { url, footerElement }: Props = $props();

  let fabHidden = $state(false);

  onMount(() => {
    const footer = document.querySelector(footerElement);
    const observer = new IntersectionObserver(
      ([entry]) => {
        fabHidden = entry.isIntersecting;
      },
      { threshold: 0.25 },
    );
    if (footer) observer.observe(footer);
    return () => observer.disconnect();
  });

  let menuStateOpen = $state(false);

  let scrollToTopVisible = $state(true);

  let linksListModalVisible = $state(false);

  let pageUrlShareModalVisible = $state(false);
  let pageUrlShareContent = $derived(url.toString());
  let pageUrlShareNative = $state(false);

  onMount(() => {
    pageUrlShareNative = !!navigator.share;
  });

  $effect(() => {
    if (menuStateOpen) {
      scrollToTopVisible = window.scrollY !== 0;
    }
  });

  function scrollToTop() {
    menuStateOpen = false;
    window.scrollTo({
      top: 0,
    });
  }

  function linksListCallback() {
    menuStateOpen = false;
    linksListModalVisible = true;
  }

  async function pageUrlShareCallback() {
    menuStateOpen = false;
    if (pageUrlShareNative) {
      try {
        await navigator.share({
          title: siteConfig.title,
          text: siteConfig.description,
          url: pageUrlShareContent,
        });
        return;
      } catch (error) {
        if (error instanceof Error && error.name === "AbortError") {
          return;
        }
      }
    }
    pageUrlShareModalVisible = true;
  }

  // let switchUserThemeButtons: Record<string, Component> = $state({
  //   dark: MoonSolid,
  //   light: SunSolid,
  //   auto: DesktopPcSolid,
  // });
</script>

