---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import ProseAnchor from '#/components/blocks/ProseAnchor.svelte';
import { HeadingFancy } from '#/components/ui';
import LayoutDefault from '#/layouts/Default.astro';

export async function getStaticPaths() {
  const collection = await getCollection('pages');
  return collection.map((entry) => {
    return {
      params: { id: entry.id },
      props: { page: entry },
    };
  });
}
interface Props {
  page: CollectionEntry<'pages'>;
}
const { page } = Astro.props as Props;
const { Content } = await render(page);

const components = {
  a: ProseAnchor,
};
---

<LayoutDefault
  title={page.data.title}
  breadcrumbs={[page.data.title]}
  supportsSearchIndex={true}
>
  <HeadingFancy
    tag="h1"
    title={page.data.title}
    subtitle={page.data.subtitle}
  />
  <div role="alert" class="alert alert-info alert-soft w-fit">
    <span>Last updated {page.data.date.toDateString()}</span>
  </div>
  <div class="prose">
    <Content {components} />
  </div>
</LayoutDefault>
