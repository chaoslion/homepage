---
import { getBlogPostsCollectionSorted } from '#/data/blog';
import LayoutPost from '#/layouts/Post.astro';
import type { PostsCollectionItem } from '#/types/collections';

export async function getStaticPaths() {
  const collection: PostsCollectionItem[] =
    await getBlogPostsCollectionSorted();
  return collection.map((post) => {
    return {
      params: { id: post.id },
      props: { post },
    };
  });
}
type Props = { post: PostsCollectionItem };
const { post } = Astro.props as Props;
---

<LayoutPost {post} />
